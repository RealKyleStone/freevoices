# FreeVoices server configuration.
# Copy to `.env` and fill in. Never commit `.env` — it is gitignored.

NODE_ENV=development
PORT=3000
# Base URL used to build links in outbound email (verification, password reset).
APP_URL=http://localhost:4200

# ─── Database ─────────────────────────────────────────────────────────────────
DB_HOST=localhost
DB_USER=
DB_PASSWORD=
DB_NAME=
DB_CONNECTION_LIMIT=20
DB_QUEUE_LIMIT=0
DB_ENABLE_KEEP_ALIVE=true
DB_KEEP_ALIVE_INITIAL_DELAY=10000

# Transport encryption for the DB connection.
#   disabled | required (encrypt, do not authenticate) | verify (encrypt + authenticate)
# Defaults to `disabled` for a local host, `required` for anything remote.
#
# Running the API on the same machine as MySQL (DB_HOST=localhost) is strongly
# preferred — the traffic never touches a network and none of this matters.
# If the DB really is remote, `required` alone stops passive sniffing but NOT an
# active man-in-the-middle. For real verification, pin the server certificate:
#   DB_SSL=verify
#   DB_SSL_CA=./certs/mysql-server.pem
#   DB_SSL_SKIP_HOSTNAME=true
# The skip is needed when the server presents MariaDB's auto-generated
# certificate (CN="MariaDB Server", no subjectAltNames), which no hostname can
# ever match. The pinned CA is what does the authenticating in that case.
DB_SSL=
DB_SSL_CA=
DB_SSL_SKIP_HOSTNAME=

# ─── Email (SMTP) ─────────────────────────────────────────────────────────────
SMTP_HOST=
# 465 = implicit TLS, 587 = STARTTLS. The code derives TLS mode from the port.
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
# Optional; SMTP_FROM is used when these are unset.
SMTP_FROM_NAME=
SMTP_FROM_ADDRESS=
# Dumps the full SMTP conversation (recipients, content) to the log. Off unless
# actively debugging — it is a personal-data leak into log files.
SMTP_DEBUG=false
# Escape hatch for a broken/expired host certificate. Leaving this true
# contradicts the "encrypted in transit" claim in the privacy policy.
SMTP_TLS_INSECURE=false

# ─── Sessions ─────────────────────────────────────────────────────────────────
# Idle window, slid forward on use; and the hard ceiling from session creation.
SESSION_IDLE_HOURS=12
SESSION_MAX_DAYS=7

# ─── Brute-force controls ─────────────────────────────────────────────────────
LOGIN_MAX_FAILURES=10
LOGIN_LOCKOUT_MINUTES=15
# Set true only for load testing. Never in production.
RATE_LIMIT_DISABLED=false

# ─── reCAPTCHA ────────────────────────────────────────────────────────────────
# reCAPTCHA v2 Invisible, web only — the native shell cannot run it, so a
# missing token is accepted and rate limiting plus lockout are the real control.
RECAPTCHA_SECRET_KEY=
CAPTCHA_DISABLED=false

# ─── HTTP hardening ───────────────────────────────────────────────────────────
# Number of reverse proxies in front of the app. Required for req.ip to be the
# real client rather than the proxy — every IP in the audit trail depends on it.
TRUST_PROXY_HOPS=1
# Comma-separated. Unset uses the built-in list (freevoices.co.za plus the
# Capacitor origins https://localhost and capacitor://localhost).
CORS_ALLOWED_ORIGINS=
# CSP_REPORT_ONLY=true downgrades CSP to reporting if it ever breaks the app —
# useful as an emergency lever, but not a place to leave it.
CSP_ENABLED=true
CSP_REPORT_ONLY=false
