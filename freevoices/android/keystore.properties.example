# Release signing configuration — copy to `keystore.properties` and fill in.
#
# `keystore.properties`, `*.jks` and `*.keystore` are gitignored. Never commit
# them: anyone with the upload key can publish an update to your listing.
#
# Generate the key (run from the android/ directory):
#
#   keytool -genkeypair -v \
#     -keystore freevoices-upload.jks \
#     -keyalg RSA -keysize 4096 -validity 10000 \
#     -alias freevoices-upload
#
# Then, before your first upload, ENROL IN PLAY APP SIGNING. Google holds the
# real app-signing key and you keep only an upload key, so a lost upload key can
# be reset by support. Without it, losing this file means you can never publish
# an update to the listing again — there is no recovery.
#
# Back the .jks up somewhere offline, in two places, along with these passwords.

storeFile=freevoices-upload.jks
storePassword=CHANGE_ME
keyAlias=freevoices-upload
keyPassword=CHANGE_ME
