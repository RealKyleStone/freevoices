<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">

        <activity
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|locale|smallestScreenSize|screenLayout|uiMode"
            android:name=".MainActivity"
            android:label="@string/title_activity_main"
            android:theme="@style/AppTheme.NoActionBarLaunch"
            android:launchMode="singleTask"
            android:exported="true">

            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>

        </activity>

        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths"></meta-data>
        </provider>
    </application>

    <!-- Permissions -->

    <uses-permission android:name="android.permission.INTERNET" />

    <!--
      Needed so scheduled invoice reminders survive a reboot.
    -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
    <uses-permission android:name="android.permission.VIBRATE" />

    <!--
      Deliberately NOT declared:

      USE_EXACT_ALARM     A restricted permission reserved for alarm-clock and
                          calendar apps. Play requires a declaration form
                          justifying it, and an invoicing app has no defensible
                          justification — a likely rejection on its own.
      SCHEDULE_EXACT_ALARM Not needed either. An invoice due-date reminder does
                          not care about a few minutes of drift, and
                          @capacitor/local-notifications degrades cleanly:
                          LocalNotificationManager.setExactIfPossible() checks
                          canScheduleExactAlarms() and falls back to
                          setAndAllowWhileIdle() with a warning. No exception.
      BLUETOOTH_CONNECT   Nothing in this app uses Bluetooth. Declaring it
                          invites a "why do you need this?" review question.
    -->

</manifest>
