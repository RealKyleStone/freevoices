<?xml version="1.0" encoding="utf-8"?>
<!--
  Belt and braces alongside android:allowBackup="false".

  Android Auto Backup copies the app's data directory, which includes the
  WebView's local storage — where the session token and cached account details
  live. That would send a bearer token to a store the user cannot inspect, and
  restore it onto a new device, silently signing that device in as the user.

  allowBackup="false" already prevents this, but some OEM device-transfer
  implementations honour these rules rather than the flag, and API 31+ handles
  cloud backup and device transfer through separate paths. Excluding the whole
  domain in both is cheap, and there is nothing here worth backing up: every
  byte is re-fetchable from the server after signing in.
-->
<data-extraction-rules>

    <cloud-backup>
        <exclude domain="root" />
    </cloud-backup>

    <device-transfer>
        <exclude domain="root" />
    </device-transfer>

</data-extraction-rules>
